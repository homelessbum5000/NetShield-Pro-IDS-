# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# NetShield Pro backend (FastAPI). The Secrets Gradle Plugin turns this into
# BuildConfig.NETSHIELD_BACKEND_URL. Use https:// in production.
# Default (when blank) points at the dev host from the Android emulator.
NETSHIELD_BACKEND_URL=http://10.0.2.2:8000/

# Set to "true" to restore the old in-app mock network simulator (canned
# responses, no real backend). Default "false" hits the real backend.
NETSHIELD_USE_MOCK_NETWORK=false
