# ---- Compute provider ----
# local | cudaq | cuquantum | qrng | ibm | braket
COMPUTE_PROVIDER=local

# ---- Server ----
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*

# ---- QRNG (optional) ----
# Example: https://api.qrngapi.com/api/random
QRNG_API_URL=
QRNG_API_KEY=

# ---- IBM Quantum (optional, async research jobs only) ----
IBM_TOKEN=
IBM_INSTANCE=

# ---- Kyber ----
USE_REAL_KYBER=true
